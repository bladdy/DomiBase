# Entorno
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# PostgreSQL en Docker (solo desarrollo)
DOMIBASE_POSTGRES_PORT=5433

# Puertos publicados por el stack Docker local (solo loopback)
DOMIBASE_API_PORT=5080
DOMIBASE_ADMIN_PORT=5190
POSTGRES_USER=domibase_admin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_CONTROL_DB=domibase_control

# Cadenas de conexion (placeholders; ajustar al .env local)
CONTROL_DB_CONNECTION_STRING=Host=127.0.0.1;Port=5433;Database=domibase_control;Username=domibase_admin;Password=change-me-local-only
PROVISIONING_DB_CONNECTION_STRING=Host=127.0.0.1;Port=5433;Database=postgres;Username=domibase_admin;Password=change-me-local-only

# Seguridad de la API (generar valores fuertes fuera de Git)
# Token permanente de servicio: solo para automatizaciones/tests, no se envía al panel.
DOMIBASE_ADMIN_TOKEN=change-me-generate-strong-token

# Login del propietario: credenciales canjeables por una sesión firmada y caducable.
DOMIBASE_ADMIN_USERNAME=owner
DOMIBASE_ADMIN_PASSWORD=change-me-strong-owner-password
DOMIBASE_ADMIN_SESSION_SECRET=change-me-32-byte-minimum-session-secret
DOMIBASE_ADMIN_SESSION_HOURS=12

# Pepper de API keys. El primero de la lista firma las claves nuevas; el resto solo verifica.
# DOMIBASE_API_KEY_PEPPER se conserva como pepper retirado si se define el keyring.
DOMIBASE_API_KEY_PEPPERS=change-me-active-pepper,change-me-retired-pepper
DOMIBASE_API_KEY_PEPPER=change-me-retired-pepper

# Keyring AES-256 (32 bytes por clave, en base64) para cifrar secretos de Runtime en domibase_control.
# Formato: id:base64-clave separado por comas; el primero cifra y el resto solo descifra.
# Generar cada clave: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
DOMIBASE_SECRETS_KEYS=active:change-me-base64-32-bytes,retired:change-me-other-base64-32-bytes
# Clave histórica: necesaria mientras queden valores cifrados con el formato v1.
DOMIBASE_SECRETS_KEY=change-me-other-base64-32-bytes

# Runtime Plane (PostgreSQL de proyectos)
# Sin usuario/contraseña administrativos: usa el login por proyecto y el host/puerto indicados.
RUNTIME_DB_HOST=127.0.0.1
RUNTIME_DB_PORT=5433
RUNTIME_DB_SSL_MODE=Prefer
RUNTIME_DB_MAX_POOL_SIZE=20

# Rate limit del Runtime Plane (valores por defecto; se validan al arrancar).
# Permits: 1-10000. Window: 1-3600 segundos. Se pueden sobrescribir por proyecto
# con PATCH /api/v1/projects/{id}/rate-limit; null hereda estos valores.
RUNTIME_RATE_LIMIT_PERMITS=300
RUNTIME_RATE_LIMIT_WINDOW_SECONDS=60

# Storage Plane
STORAGE_ROOT=./storage
STORAGE_MAX_OBJECT_SIZE_BYTES=10485760
STORAGE_SIGNING_KEY=change-me-storage-signing-key

# Backups lógicos (Control Plane)
# Directorio dedicado fuera del repositorio; nunca dentro de backend/ ni frontend/.
BACKUP_ROOT=./backups
# 'process' usa pg_dump/pg_restore del PATH; 'docker' los ejecuta dentro del contenedor.
BACKUP_TOOL_MODE=docker
BACKUP_DOCKER_CONTAINER=domibase-postgres
BACKUP_TIMEOUT_SECONDS=300
BACKUP_MAX_BYTES=1073741824

# SDK / ejemplos
DOMIBASE_API_URL=http://localhost:5080
DOMIBASE_PROJECT_PUBLIC_KEY=db_public_example_replace_me
