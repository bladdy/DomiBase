# Server-only values consumed by Astro through astro:env/server.
# Never prefix these with PUBLIC_: they must not reach the browser bundle.
# scripts/dev/phase-06-demo.mjs writes the real .env file with freshly created keys.
DOMIBASE_API_URL=http://localhost:5080
DOMIBASE_PROJECT_KEY=db_public_replace_me
DOMIBASE_PROJECT_KEY_B=db_public_replace_me_b
DOMIBASE_REVOKED_PROJECT_KEY=db_public_revoked_replace_me
DOMIBASE_PROJECT_NAME="Paneles Solares"
DOMIBASE_PROJECT_NAME_B="Aislamiento Demo"
