{
  "name": "domibase-astro-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Astro SSR example consuming the DomiBase Runtime API with @domibase/client",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build:sdk": "npm --prefix ../../packages/client run build",
    "dev": "npm run build:sdk && astro dev",
    "build": "npm run build:sdk && astro build",
    "preview": "npm run build:sdk && astro preview",
    "check": "npm run build:sdk && astro check",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@domibase/client": "file:../../packages/client",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.3"
  }
}
