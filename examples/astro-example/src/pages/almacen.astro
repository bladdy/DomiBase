---
import Layout from "../layouts/Layout.astro";
import {
  AUTH_COOKIES,
  DEMO_BUCKET,
  createObjectSignedUrl,
  describeError,
  listStoredObjects,
  readSessionFromCookies,
  removeStoredObject,
  uploadTextObject,
  type StorageObject
} from "../lib/domibase";

export const prerender = false;

interface Notice {
  kind: "success" | "error";
  text: string;
}

let notice: Notice | null = null;
let formValues = { path: "", content: "" };
let signedUrl: string | null = null;
const fieldErrors: Record<string, string> = {};

const session = readSessionFromCookies(Astro.cookies);
if (!session) {
  return Astro.redirect("/login", 303);
}

if (Astro.request.method === "POST") {
  let form: FormData | null = null;
  try {
    form = await Astro.request.formData();
  } catch {
    Astro.response.status = 400;
    notice = { kind: "error", text: "El formulario no se pudo leer." };
  }

  if (form) {
    const intent = form.get("intent");

    if (intent === "logout") {
      for (const name of Object.values(AUTH_COOKIES)) {
        Astro.cookies.delete(name, { path: "/" });
      }
      return Astro.redirect("/login", 303);
    }

    if (intent === "upload") {
      formValues = {
        path: String(form.get("path") ?? "").trim(),
        content: String(form.get("content") ?? "")
      };

      if (formValues.path.length === 0) {
        fieldErrors.path = "Escribe una ruta.";
      }

      if (Object.keys(fieldErrors).length > 0) {
        Astro.response.status = 400;
      } else {
        const result = await uploadTextObject(session, formValues.path, formValues.content);
        if (result.error) {
          Astro.response.status = 502;
          notice = { kind: "error", text: describeError(result.error) };
        } else {
          return Astro.redirect("/almacen?ok=uploaded", 303);
        }
      }
    }

    if (intent === "remove") {
      const path = String(form.get("path") ?? "");
      const result = await removeStoredObject(session, path);
      if (result.error) {
        Astro.response.status = 502;
        notice = { kind: "error", text: describeError(result.error) };
      } else {
        return Astro.redirect("/almacen?ok=removed", 303);
      }
    }

    if (intent === "sign") {
      const path = String(form.get("path") ?? "");
      const result = await createObjectSignedUrl(session, path);
      if (result.error) {
        Astro.response.status = 502;
        notice = { kind: "error", text: describeError(result.error) };
      } else {
        signedUrl = result.data?.url ?? null;
      }
    }
  }
}

const okParam = Astro.url.searchParams.get("ok");
if (okParam === "uploaded") {
  notice = { kind: "success", text: "Objeto subido con el SDK de Storage." };
} else if (okParam === "removed") {
  notice = { kind: "success", text: "Objeto eliminado." };
}

let objects: StorageObject[] = [];
let listError: string | null = null;
try {
  const result = await listStoredObjects(session);
  objects = (result.data ?? []) as StorageObject[];
  listError = result.error ? describeError(result.error) : null;
} catch {
  listError = "No se pudieron listar los objetos.";
}
---

<Layout title="Almacén" current="almacen">
  <header class="page-head">
    <p class="eyebrow">Storage Plane · upload con sesión autenticada</p>
    <h1>Almacenamiento de objetos</h1>
    <p class="lede">
      Los archivos se guardan en el bucket <code>{DEMO_BUCKET}</code>. Solo un usuario con sesión
      puede subir y borrar; la lectura pública depende de la configuración del bucket creada por el
      script de Provisioning.
    </p>
  </header>

  <div class="stack">
    {notice && (
      <div class={`notice notice-${notice.kind}`} role={notice.kind === "error" ? "alert" : "status"}>
        {notice.text}
      </div>
    )}

    {listError && (
      <div class="notice notice-error" role="alert">
        <strong>No se pudieron cargar los objetos.</strong>
        <span>{listError}</span>
      </div>
    )}

    <section class="card" aria-labelledby="upload-title">
      <p class="eyebrow">POST /storage/v1</p>
      <h2 id="upload-title">Subir objeto de texto</h2>
      <form class="contact-form" method="POST" action="/almacen">
        <input type="hidden" name="intent" value="upload" />
        <div class="field">
          <label for="path">Ruta</label>
          <input id="path" name="path" type="text" maxlength="200" value={formValues.path} placeholder="notas/hola.txt" required />
          {fieldErrors.path && <p class="field-error">{fieldErrors.path}</p>}
        </div>
        <div class="field field-wide">
          <label for="content">Contenido</label>
          <textarea id="content" name="content" rows="4">{formValues.content}</textarea>
        </div>
        <div class="form-actions">
          <button class="button button-primary" type="submit">Subir</button>
          <span class="hint">El cuerpo se envía como bytes, no como JSON.</span>
        </div>
      </form>
    </section>

    <section class="card" aria-labelledby="objects-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">GET /storage/v1/{DEMO_BUCKET}</p>
          <h2 id="objects-title">Objetos</h2>
        </div>
        <span class="count" role="status">{objects.length} {objects.length === 1 ? "objeto" : "objetos"}</span>
      </div>

      {objects.length > 0 ? (
        <div class="table-shell">
          <table>
            <thead>
              <tr>
                <th scope="col">Ruta</th>
                <th scope="col">Tipo</th>
                <th scope="col">Tamaño</th>
                <th scope="col">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {objects.map((obj) => (
                <tr>
                  <td><strong>{obj.path}</strong></td>
                  <td>{obj.contentType ?? "—"}</td>
                  <td>{obj.size} B</td>
                  <td>
                    <form class="inline-form" method="POST" action="/almacen" style="display: inline;">
                      <input type="hidden" name="intent" value="sign" />
                      <input type="hidden" name="path" value={obj.path} />
                      <button class="button button-small" type="submit">Firmar URL</button>
                    </form>
                    <form class="inline-form" method="POST" action="/almacen" style="display: inline; margin-left: 0.5rem;">
                      <input type="hidden" name="intent" value="remove" />
                      <input type="hidden" name="path" value={obj.path} />
                      <button class="button button-small" type="submit">Borrar</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty">
          <strong>Sin objetos todavía</strong>
          <span>Sube un archivo para verlo aquí.</span>
        </div>
      )}
    </section>

    {signedUrl && (
      <section class="card" aria-labelledby="signed-title">
        <p class="eyebrow">URL firmada (15 min)</p>
        <h2 id="signed-title">Enlace de descarga</h2>
        <p class="hint" style="overflow-wrap: anywhere;"><code>{signedUrl}</code></p>
        <a class="button button-small" href={signedUrl}>Descargar</a>
      </section>
    )}

    <form class="inline-form" method="POST" action="/almacen">
      <input type="hidden" name="intent" value="logout" />
      <button class="button button-small" type="submit">Cerrar sesión</button>
    </form>
  </div>
</Layout>
