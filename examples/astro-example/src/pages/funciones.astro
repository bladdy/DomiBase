---
import Layout from "../layouts/Layout.astro";
import {
  AUTH_COOKIES,
  DEMO_FUNCTION,
  describeError,
  invokeDemoFunction,
  readSessionFromCookies
} from "../lib/domibase";

export const prerender = false;

interface Notice {
  kind: "success" | "error";
  text: string;
}

let notice: Notice | null = null;
let payloadText = '{\n  "mensaje": "hola desde Astro"\n}';
let resultJson: string | null = null;
let invocationError: string | null = null;

const session = readSessionFromCookies(Astro.cookies);
if (!session) {
  return Astro.redirect("/login", 303);
}

if (Astro.request.method === "POST") {
  let form: FormData | null = null;
  try {
    form = await Astro.request.formData();
  } catch {
    Astro.response.status = 400;
    notice = { kind: "error", text: "El formulario no se pudo leer." };
  }

  if (form) {
    const intent = form.get("intent");

    if (intent === "logout") {
      for (const name of Object.values(AUTH_COOKIES)) {
        Astro.cookies.delete(name, { path: "/" });
      }
      return Astro.redirect("/login", 303);
    }

    if (intent === "invoke") {
      payloadText = String(form.get("payload") ?? "");

      let payload: unknown;
      let parsed = true;
      try {
        payload = JSON.parse(payloadText);
      } catch {
        parsed = false;
        Astro.response.status = 400;
        notice = { kind: "error", text: "El payload debe ser un JSON válido." };
      }

      if (parsed) {
        const result = await invokeDemoFunction(session, payload);
        if (result.error) {
          Astro.response.status = 502;
          invocationError = describeError(result.error);
        } else {
          resultJson = JSON.stringify(result.data, null, 2);
          notice = { kind: "success", text: "Función ejecutada en un worker WASM aislado." };
        }
      }
    }
  }
}
---

<Layout title="Funciones" current="funciones">
  <header class="page-head">
    <p class="eyebrow">Functions Plane · invocación con contexto autenticado</p>
    <h1>Funciones WebAssembly</h1>
    <p class="lede">
      La función <code>{DEMO_FUNCTION}</code> se ejecuta en un proceso worker independiente, sin
      red ni sistema de archivos. El módulo devuelve el payload junto con el contexto que el Runtime
      deriva de la sesión: el <code>projectId</code> y el <code>userId</code> nunca los decide el
      navegador.
    </p>
  </header>

  <div class="stack">
    {notice && (
      <div class={`notice notice-${notice.kind}`} role={notice.kind === "error" ? "alert" : "status"}>
        {notice.text}
      </div>
    )}

    {invocationError && (
      <div class="notice notice-error" role="alert">
        <strong>La invocación fue rechazada.</strong>
        <span>{invocationError}</span>
      </div>
    )}

    <section class="card" aria-labelledby="invoke-title">
      <p class="eyebrow">POST /functions/v1/{DEMO_FUNCTION}</p>
      <h2 id="invoke-title">Invocar la función</h2>
      <form class="contact-form" method="POST" action="/funciones">
        <input type="hidden" name="intent" value="invoke" />
        <div class="field field-wide">
          <label for="payload">Payload JSON</label>
          <textarea id="payload" name="payload" rows="6" spellcheck="false">{payloadText}</textarea>
          <p class="hint">Se valida en el servidor antes de enviarse al worker.</p>
        </div>
        <div class="form-actions">
          <button class="button button-primary" type="submit">Invocar</button>
          <span class="hint">Límites: 1 M de fuel · 16 páginas · 1 s.</span>
        </div>
      </form>
    </section>

    <section class="card" aria-labelledby="result-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">Respuesta envuelta en { "{ data }" }</p>
          <h2 id="result-title">Resultado</h2>
        </div>
        <span class="count" role="status">{resultJson ? "respuesta recibida" : "sin invocaciones"}</span>
      </div>

      {resultJson ? (
        <pre class="result-block">{resultJson}</pre>
      ) : (
        <div class="empty">
          <strong>Sin resultado todavía</strong>
          <span>Envía un payload para ver la respuesta del módulo.</span>
        </div>
      )}
    </section>

    <form class="inline-form" method="POST" action="/funciones">
      <input type="hidden" name="intent" value="logout" />
      <button class="button button-small" type="submit">Cerrar sesión</button>
    </form>
  </div>
</Layout>

<style>
  .result-block {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    background: var(--surface-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
