---
import Layout from "../layouts/Layout.astro";
import {
  AUTH_COOKIES,
  readSessionFromCookies,
  serializeSession,
  signInWithPassword,
  signUp
} from "../lib/domibase";

export const prerender = false;

interface Notice {
  kind: "success" | "error";
  text: string;
}

let notice: Notice | null = null;
const fieldErrors: Record<string, string> = {};

const existing = readSessionFromCookies(Astro.cookies);
if (existing) {
  return Astro.redirect("/notas", 303);
}

if (Astro.request.method === "POST") {
  let form: FormData | null = null;

  try {
    form = await Astro.request.formData();
  } catch {
    Astro.response.status = 400;
    notice = { kind: "error", text: "El formulario no se pudo leer." };
  }

  if (form) {
    const intent = formText(form, "intent");
    const email = formText(form, "email").trim().toLowerCase();
    const password = formText(form, "password");

    if (email.length === 0 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      fieldErrors.email = "Escribe un correo válido.";
    }

    if (password.length < 8) {
      fieldErrors.password = "La contraseña necesita al menos 8 caracteres.";
    }

    if (Object.keys(fieldErrors).length > 0) {
      Astro.response.status = 400;
    } else {
      const result =
        intent === "register"
          ? await signUp(email, password)
          : await signInWithPassword(email, password);

      if (result.error || !result.session) {
        Astro.response.status = 401;
        notice = { kind: "error", text: result.error?.message ?? "No se pudo iniciar sesión." };
      } else {
        const cookies = serializeSession(result.session);
        for (const [name, value] of Object.entries(cookies)) {
          Astro.cookies.set(name, value, {
            httpOnly: true,
            secure: import.meta.env.PROD,
            sameSite: "lax",
            path: "/",
            maxAge: 60 * 60 * 24 * 7
          });
        }
        return Astro.redirect("/notas", 303);
      }
    }
  }
}

function formText(form: FormData, name: string): string {
  const value = form.get(name);
  return typeof value === "string" ? value : "";
}
---

<Layout title="Iniciar sesión" current="inicio">
  <header class="page-head">
    <p class="eyebrow">Auth Plane · sesiones</p>
    <h1>Acceso al ejemplo</h1>
    <p class="lede">
      Regístrate o inicia sesión. La sesión se guarda en una cookie <code>httpOnly</code> y el SDK
      envía el access token como <code>Authorization: Bearer</code> en las peticiones al Runtime.
    </p>
  </header>

  <div class="stack">
    {
      notice && (
        <div class={`notice notice-${notice.kind}`} role="alert">
          {notice.text}
        </div>
      )
    }

    <section class="card" style="max-width: 28rem;">
      <form class="contact-form" method="POST" action="/login">
        <div class="field field-wide">
          <label for="email">Correo</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
          {fieldErrors.email && <p class="field-error">{fieldErrors.email}</p>}
        </div>

        <div class="field field-wide">
          <label for="password">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            minlength="8"
            required
          />
          {fieldErrors.password && <p class="field-error">{fieldErrors.password}</p>}
        </div>

        <div class="form-actions">
          <button class="button button-primary" type="submit" name="intent" value="login">
            Iniciar sesión
          </button>
          <button class="button" type="submit" name="intent" value="register">
            Registrarse
          </button>
        </div>
      </form>
    </section>
  </div>
</Layout>
